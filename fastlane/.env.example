# 复制为 fastlane/.env 后填写（fastlane 会自动加载，该文件已被 git 忽略）
# App Store Connect → 用户和访问 → 集成 → App Store Connect API，新建一个“管理”角色的密钥
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# .p8 文件的绝对路径，建议放在仓库外，例如 ~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
ASC_KEY_PATH=/Users/you/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
